<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the sign-in session never leaves the phone through backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
