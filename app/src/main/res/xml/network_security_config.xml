<?xml version="1.0" encoding="utf-8"?>
<!-- Podcast enclosures and the Mac skip-list server are frequently plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
